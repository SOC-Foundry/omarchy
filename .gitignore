# Local / backup noise — keep the ledger clean
*.bak
*.bak.*
README.md.bak.*
**/*.bak.chg*
**/*.pre-backout.*

# Editor / OS
.DS_Store
*~
*.swp
.idea/
.vscode/
*.code-workspace

# Secrets / keys (never commit)
*.pem
*.key
*credentials*
.env
.env.*
!/*.example

# Vendor installers + makepkg artifacts (Island .deb is ~191M)
*.deb
*.pkg.tar.zst
pkg/*/src/
pkg/*/pkg/
